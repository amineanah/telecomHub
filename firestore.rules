rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visitorFeedback/{feedbackId} {
      function isAdmin() {
        return request.auth != null && request.auth.uid == "wq68WfHSlzW1SNCeyIC2uoNwYvd2";
      }
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'message', 'rating', 'status', 'authorUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'rating', 'status', 'authorUid', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin() || resource.data.status == 'approved';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}